v {xschem version=3.4.8RC file_version=1.3}
G {}
K {type=subcircuit
format="@name @pinlist i2c_gpio_2bit_fullchip"
template="name=x1"
}
V {}
S {}
F {}
E {}
P 4 5 -100 -120 100 -120 100 120 -100 120 -100 -120 {}
T {i2c_gpio_2bit} -85 -105 0 0 0.18 0.18 {}
L 7 0 -150 0 -120 {}
B 5 -2.5 -152.5 2.5 -147.5 {name=VDD dir=inout pinnumber=1 sim_pinnumber=1}
L 7 0 120 0 150 {}
B 5 -2.5 147.5 2.5 152.5 {name=VSS dir=inout pinnumber=2 sim_pinnumber=2}
L 4 -120 -60 -100 -60 {}
B 5 -122.5 -62.5 -117.5 -57.5 {name=SCL dir=in pinnumber=3 sim_pinnumber=3}
L 4 -120 -20 -100 -20 {}
B 5 -122.5 -22.5 -117.5 -17.5 {name=SDA dir=inout pinnumber=4 sim_pinnumber=4}
L 4 -120 20 -100 20 {}
B 5 -122.5 17.5 -117.5 22.5 {name=GPIO0 dir=inout pinnumber=5 sim_pinnumber=5}
L 4 -120 60 -100 60 {}
B 5 -122.5 57.5 -117.5 62.5 {name=GPIO1 dir=inout pinnumber=6 sim_pinnumber=6}
